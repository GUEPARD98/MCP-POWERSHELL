# Configuración específica para usuario HP - PC Local
# SSH-PowerShell MCP Server v1.0.0

# ===========================================
# CONFIGURACIÓN DE CLAVES SSH
# ===========================================

# Clave SSH para servidor Kali (configuración principal)
SSH_KEY_PATH=C:\Users\HP\.ssh\kali_key

# Clave SSH alternativa (funciona para otros servidores)
# SSH_KEY_PATH=C:\Users\HP\.ssh\id_rsa

# Passphrase para la clave SSH (opcional, descomenta si tu clave tiene passphrase)
# SSH_PASSPHRASE=tu_passphrase_aqui

# ===========================================
# CONFIGURACIÓN DE CONEXIONES SSH
# ===========================================

# Configuración del servidor Kali
SSH_DEFAULT_HOST=192.168.1.12
SSH_DEFAULT_USER=kali
SSH_DEFAULT_PORT=22

# Configuración de conexión SSH específica
SSH_STRICT_HOST_KEY_CHECKING=no

# ===========================================
# CONFIGURACIÓN DE TIMEOUTS
# ===========================================

# Tiempo de espera para comandos (en milisegundos)
COMMAND_TIMEOUT=30000

# Timeout para conexiones SSH (en milisegundos)
SSH_TIMEOUT=10000

# ===========================================
# CONFIGURACIÓN DE LOGGING
# ===========================================

# Nivel de log (debug, info, warn, error)
LOG_LEVEL=info

# Habilitar logs detallados para debugging
DEBUG_MODE=false

# ===========================================
# CONFIGURACIÓN DE CLAUDE DESKTOP
# ===========================================

# Nombre del servidor MCP
MCP_SERVER_NAME=ssh-powershell-mcp

# Puerto del servidor MCP (opcional)
MCP_SERVER_PORT=3000

# ===========================================
# CONFIGURACIÓN DE SEGURIDAD
# ===========================================

# Verificación estricta de claves de host SSH (deshabilitado para Kali local)
SSH_STRICT_HOST_KEY_CHECKING=no

# Número de reintentos de conexión
SSH_CONNECTION_RETRIES=3

# ===========================================
# CONFIGURACIÓN DE WINDOWS/POWERSHELL
# ===========================================

# Directorio de trabajo por defecto
WORKING_DIRECTORY=D:\GOOSE

# Shell por defecto para comandos locales
DEFAULT_SHELL=powershell

# Codificación de caracteres
CHARSET=utf-8