# Configuración de producción para SSH-PowerShell MCP Server
# Ruta a clave SSH (Windows - producción)
SSH_KEY_PATH=%USERPROFILE%\.ssh\production_key

# Puerto SSH por defecto
SSH_DEFAULT_PORT=22

# Usuario SSH por defecto para producción
SSH_DEFAULT_USER=admin

# Timeouts optimizados para producción
COMMAND_TIMEOUT=30000
SSH_TIMEOUT=10000

# Logs mínimos para producción
LOG_LEVEL=warn
DEBUG_MODE=false

# Configuración de Claude Desktop
MCP_SERVER_NAME=ssh-powershell-prod
MCP_SERVER_PORT=3001

# Configuraciones de seguridad adicionales
SSH_STRICT_HOST_KEY_CHECKING=yes
SSH_CONNECTION_RETRIES=3