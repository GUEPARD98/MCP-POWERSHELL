{
  "name": "ssh-powershell-mcp-server",
  "version": "1.0.0",
  "description": "Enterprise SSH and PowerShell MCP Server for Claude Desktop",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1 -Environment development",
    "prod": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1 -Environment production",
    "test": "powershell -ExecutionPolicy Bypass -File scripts/test.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop.ps1"
  },
  "keywords": [
    "mcp",
    "ssh",
    "powershell",
    "claude",
    "automation",
    "remote-execution",
    "enterprise"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.3.1",
    "shell-escape": "^0.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/block/ssh-powershell-mcp.git"
  },
  "author": "SSH-PowerShell MCP Team",
  "license": "MIT"
}